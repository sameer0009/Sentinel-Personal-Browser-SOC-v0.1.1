{
  "manifest_version": 3,
  "name": "Sentinel — Personal Browser SOC",
  "short_name": "Sentinel SOC",
  "version": "0.1.2",
  "author": "dev-hunters studio",
  "description": "Local-only browser security monitor: flags phishing, typosquats and insecure logins, blocks trackers, and scores your posture.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Sentinel SOC",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "webNavigation",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sentinel_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      }
    ]
  }
}
